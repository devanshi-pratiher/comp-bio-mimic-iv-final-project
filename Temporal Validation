    "\n",
    "# Parse admission time\n",
    "survival_cohort['admittime'] = pd.to_datetime(survival_cohort['admittime'])\n",
    "survival_cohort['admit_year'] = survival_cohort['admittime'].dt.year\n",
    "\n",
    "infection_cohort['admittime'] = pd.to_datetime(infection_cohort['admittime'])\n",
    "infection_cohort['admit_year'] = infection_cohort['admittime'].dt.year\n",
