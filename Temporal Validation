    "\n",
    "print(\"\\nSurvival cohort by year:\")\n",
    "year_dist_surv = survival_cohort['admit_year'].value_counts().sort_index()\n",
    "for year, count in year_dist_surv.items():\n",
    "    print(f\"  {year}: {count:,} patients ({count/len(survival_cohort):.1%})\")\n",
    "\n",
    "print(\"\\nInfection cohort by year:\")\n",
    "year_dist_inf = infection_cohort['admit_year'].value_counts().sort_index()\n",
    "for year, count in year_dist_inf.items():\n",
    "    print(f\"  {year}: {count:,} patients ({count/len(infection_cohort):.1%})\")\n",
    "\n",
